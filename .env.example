# Copy to .env (gitignored) for local runs. In GitHub Actions these are
# configured as repo secrets instead (see docs/agents/issue-tracker.md
# for how this project uses gh/GitHub).

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...
YOUTUBE_API_KEY=...
GEMINI_API_KEY=...
# only needed to run tests/test_gemini_processor_integration.py locally:
SAMPLE_VIDEO_PATH=/path/to/a/small/sample.mp4
# Web Push (VAPID) — private key is the raw base64url-encoded EC scalar
# (py_vapid "raw" format), not the PEM file. Generate with py_vapid's
# Vapid().generate_keys(), see pipeline/notifiers/web_push_notifier.py.
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:you@example.com
